<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Botão Iniciar -->
    <Button
        android:id="@+id/btComecar"
        android:layout_width="370dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:onClick="clickIniciar"
        android:text="Iniciar"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Texto de Pontuação -->
    <TextView
        android:id="@+id/txtPontuacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontuação: 0"
        android:textSize="18sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/btComecar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Texto de Recorde -->
    <TextView
        android:id="@+id/txtRecorde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recorde: 0"
        android:textSize="18sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/txtPontuacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Botão Azul -->
    <Button
        android:id="@+id/btAzul"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#0043FF"
        android:onClick="clickCor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRecorde" />

    <!-- Botão Amarelo -->
    <Button
        android:id="@+id/btAmarelo"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#FFDF01"
        android:onClick="clickCor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRecorde" />

    <!-- Botão Vermelho -->
    <Button
        android:id="@+id/btVermelho"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginStart="20dp"
        android:backgroundTint="#FC0000"
        android:onClick="clickCor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btAzul" />

    <!-- Botão Verde -->
    <Button
        android:id="@+id/btVerde"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#2DFF00"
        android:onClick="clickCor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btAmarelo" />

</androidx.constraintlayout.widget.ConstraintLayout>
